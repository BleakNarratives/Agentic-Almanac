{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgenticAlmanacEntry",
  "type": "object",
  "properties": {
    "agent_id": { "type": "string" },
    "source_url": { "type": "string" },
    "utility_score": { "type": "number" },
    "free_tier_efficiency": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "loop_risk_profile": { "type": "string" }
  },
  "required": ["agent_id", "source_url", "utility_score", "capabilities"]
}
